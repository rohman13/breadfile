{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breadfile",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "bread.beno.app",
      "custom_domain": true
    }
  ]
}
